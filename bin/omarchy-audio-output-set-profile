#!/bin/bash

# omarchy:summary=Activate an audio card output profile and make its sink default
# omarchy:args=<card-name> <profile-name>
# omarchy:hidden=true

set -euo pipefail

card_name=${1:-}
profile_name=${2:-}

if [[ -z $card_name || -z $profile_name ]]; then
  echo "Usage: omarchy-audio-output-set-profile <card-name> <profile-name>" >&2
  exit 1
fi

# Recheck the available playback routes: the panel may still show a monitor
# that was disconnected since its last refresh.
profiles=$(timeout 5 omarchy-audio-output-profiles)
if ! jq -e --arg card "$card_name" --arg profile "$profile_name" '
  any(.[]; .cardName == $card and .profileName == $profile)
' <<<"$profiles" >/dev/null; then
  echo "Audio output profile is unavailable: $card_name $profile_name" >&2
  exit 1
fi

timeout 2 pactl set-card-profile "$card_name" "$profile_name"

profile_device=${profile_name#output:}
# The full duplex profile is needed above to retain microphone capture, but
# the resulting sink identifies only its output mapping.
profile_device=${profile_device%%+*}
deadline=$((SECONDS + 3))
while (( SECONDS < deadline )); do
  sinks=$(timeout 1 pactl -f json list sinks 2>/dev/null) || break
  sink=$(jq -c --arg card "$card_name" --arg profile "$profile_device" '
    first(.[]
      | select(.properties["device.name"] == $card)
      | select(.properties["device.profile.name"] == $profile)
      | select((.ports | length) == 0 or any(.ports[]; .availability != "not available"))) // empty
  ' <<<"$sinks")
  if [[ -n $sink ]]; then
    sink_name=$(jq -r '.name' <<<"$sink")
    # wpctl needs the PipeWire object id, not PulseAudio compatibility index.
    node_id=$(jq -r '.properties["object.id"]' <<<"$sink")
    omarchy-audio-output-set-default "$node_id" "$sink_name"
    if [[ $(timeout 1 pactl get-default-sink) == "$sink_name" ]]; then
      exit 0
    else
      break
    fi
  fi
  sleep 0.1
done

echo "Could not select an available audio output: $card_name $profile_name" >&2
exit 1
